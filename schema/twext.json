{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/twext/twext/blob/main/schema/twext.json",
  "title": "Twext",
  "description": "Manifest for a Twext extension project (twext.yml).",
  "type": "object",
  "additionalProperties": true,
  "required": ["entryPoint", "extension", "blocks"],
  "properties": {
    "name": {
      "type": "string",
      "description": "Project name, used as a fallback for the extension name."
    },
    "version": {
      "type": "string",
      "description": "Project version."
    },
    "description": {
      "type": "string",
      "description": "Short description of the extension."
    },
    "author": {
      "type": "string",
      "description": "Author name or GitHub handle."
    },
    "license": {
      "type": "string",
      "description": "SPDX license identifier. Defaults to MIT."
    },
    "entryPoint": {
      "type": "string",
      "description": "Path to the entryPoint module. It must export a `blocks` map and may export `setup`."
    },
    "outputPath": {
      "type": "string",
      "description": "Where twext build writes the compiled extension. Defaults to dist/extension.js."
    },
    "extension": {
      "$ref": "#/definitions/extension"
    },
    "blocks": {
      "$ref": "#/definitions/blocks"
    }
  },
  "definitions": {
    "extension": {
      "type": "object",
      "additionalProperties": true,
      "required": ["id"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "description": "Stable ID TurboWarp uses to identify the extension."
        },
        "name": {
          "type": "string",
          "description": "Name shown in the block palette. Defaults to the project name."
        },
        "className": {
          "type": "string",
          "pattern": "^[A-Za-z_$][\\w$]*$",
          "description": "Name of the generated extension class. Defaults to a derivation of the id."
        },
        "color1": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$",
          "description": "Primary block color as a hex value."
        },
        "color2": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$",
          "description": "Secondary block color as a hex value."
        },
        "color3": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$",
          "description": "Tertiary block color as a hex value."
        }
      }
    },
    "blocks": {
      "type": "array",
      "minItems": 1,
      "description": "Block definitions. Every non-label block maps an opcode to a handler exported by the entryPoint.",
      "items": {
        "$ref": "#/definitions/block"
      }
    },
    "block": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "opcode": {
          "type": "string",
          "minLength": 1,
          "description": "Must match the key of a handler in the entryPoint `blocks` map."
        },
        "blockType": {
          "$ref": "#/definitions/blockType"
        },
        "text": {
          "type": "string",
          "description": "Label shown on the block. Defaults to the opcode."
        },
        "arguments": {
          "$ref": "#/definitions/arguments"
        }
      },
      "if": {
        "required": ["blockType"],
        "properties": {
          "blockType": {
            "const": "label"
          }
        }
      },
      "then": {},
      "else": {
        "required": ["opcode"]
      }
    },
    "blockType": {
      "type": "string",
      "enum": [
        "command",
        "reporter",
        "boolean",
        "hat",
        "event",
        "loop",
        "cond",
        "cblock",
        "button",
        "label"
      ],
      "description": "TurboWarp block type. Defaults to reporter."
    },
    "arguments": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/definitions/argument"
      }
    },
    "argument": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "type": {
          "$ref": "#/definitions/argumentType"
        },
        "defaultValue": {
          "description": "Value used when the argument is left empty."
        }
      }
    },
    "argumentType": {
      "type": "string",
      "enum": ["string", "text", "number", "boolean", "angle", "color", "matrix", "note"],
      "description": "TurboWarp argument type. Defaults to string."
    }
  }
}
