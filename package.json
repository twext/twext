{
  "name": "twext",
  "version": "0.1.0",
  "description": "A modular, zero-config Node.js toolchain for authoring, validating, and compiling multi-file TurboWarp extensions with YAML manifests",
  "author": "Twext Team",
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "twext": "src/cli.js"
  },
  "files": [
    "src",
    "product.yml"
  ],
  "engines": {
    "node": ">=24"
  },
  "keywords": [
    "turbowarp",
    "turbowarp-extension",
    "scratch",
    "scratch-extension",
    "compiler",
    "bundler",
    "twext",
    "build-tool"
  ],
  "scripts": {
    "test": "node --test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run lint && npm run format:check && npm test"
  },
  "dependencies": {
    "eslint-scope": "^9.1.2",
    "espree": "^11.2.0",
    "globals": "^17.12.0",
    "picocolors": "^1.1.1",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.10.0",
    "prettier": "^3.9.6"
  }
}
